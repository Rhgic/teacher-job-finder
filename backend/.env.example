# Copy this file to .env on the server and fill real values.

# Database
# docker compose 创建 MySQL 时使用；生产必须换成两条不同的随机值。
MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-root-password
MYSQL_DATABASE=teacher_jobs
MYSQL_USER=teacher
MYSQL_PASSWORD=change-me-to-a-long-random-database-password
# 生产用 MySQL 8（数据库须以 utf8mb4 建库，否则中文/emoji 落库出错）：
#   CREATE DATABASE teacher_jobs CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL=mysql+pymysql://teacher:change-me@127.0.0.1:3306/teacher_jobs?charset=utf8mb4
# 本地零配置跑通 / 单元测试可改回 SQLite：
# DATABASE_URL=sqlite:///./teacher_jobs.db

# 连接池（仅 MySQL/PostgreSQL 生效，留空用默认值）
# pool_recycle 必须小于 MySQL 的 wait_timeout（默认 28800 秒）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=5

# Redis（限流计数 / 每日配额 / LLM 结果缓存）
# 连不上会自动降级：限流失效但主功能不受影响
REDIS_URL=redis://127.0.0.1:6379/0
USER_DAILY_LLM_QUOTA=30
GLOBAL_DAILY_LLM_QUOTA=2000
IP_RATE_PER_MINUTE=60

# LLM
LLM_STUB_MODE=1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Mailer
MAILER_DRY_RUN=1
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WeChat auth. Production must set AUTH_DEV_MODE=0 and fill WECHAT_SECRET.
AUTH_DEV_MODE=1
WECHAT_APPID=wx2dcd7d67c642d4cb
WECHAT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_API_TOKEN=change-me-to-a-long-random-admin-token

# Resume PDF storage. Leave empty to keep generated PDFs on local disk.
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
RESUME_OUTPUT_DIR=./generated_resumes
