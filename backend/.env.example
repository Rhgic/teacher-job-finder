# Copy this file to .env on the server and fill real values.

# ---- Runtime ----
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Database
# docker compose 创建 MySQL 时使用；生产必须换成两条不同的随机值。
MYSQL_ROOT_PASSWORD=change-me-to-a-long-random-root-password
MYSQL_DATABASE=teacher_jobs
MYSQL_USER=teacher
MYSQL_PASSWORD=change-me-to-a-long-random-database-password
# 生产用 MySQL 8（数据库须以 utf8mb4 建库，否则中文/emoji 落库出错）：
#   CREATE DATABASE teacher_jobs CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
DATABASE_URL=mysql+pymysql://teacher:change-me@127.0.0.1:3306/teacher_jobs?charset=utf8mb4
# 本地零配置跑通 / 单元测试可改回 SQLite：
# DATABASE_URL=sqlite:///./teacher_jobs.db

# 连接池（仅 MySQL/PostgreSQL 生效，留空用默认值）
# pool_recycle 必须小于 MySQL 的 wait_timeout（默认 28800 秒）
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=3600
DB_POOL_TIMEOUT=5

# Redis（限流计数 / 每日配额 / LLM 结果缓存）
# 连不上会自动降级：限流失效但主功能不受影响
REDIS_URL=redis://127.0.0.1:6379/0
USER_DAILY_LLM_QUOTA=30
GLOBAL_DAILY_LLM_QUOTA=2000
IP_RATE_PER_MINUTE=60

# ---- LLM ----
# 为 1 时用占位实现，无需 API Key 即可跑通全链路；配好 Key 后设 0 启用 DeepSeek
LLM_STUB_MODE=1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# LLM 结果缓存有效期（秒），默认 1 天，重复问题直接命中缓存省钱
LLM_CACHE_TTL_SEC=86400

# ---- Embedding（RAG 检索向量化） ----
# 为 1 时用占位实现（本地哈希向量），无需 Key 即可跑通；设 0 走智谱 embedding-3
EMBEDDING_STUB_MODE=1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
# 占位维度；接真实模型后改为其维度
EMBEDDING_DIM=256
# 批量向量化每批条数
EMBEDDING_BATCH_SIZE=32

# Mailer
MAILER_DRY_RUN=1
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Web uses /auth/guest and does not require WeChat credentials.
# Fill WECHAT_APPID / WECHAT_SECRET only when the Mini Program login is enabled.
AUTH_DEV_MODE=1
WECHAT_APPID=wx2dcd7d67c642d4cb
WECHAT_SECRET=
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_API_TOKEN=change-me-to-a-long-random-admin-token

# ---- 异步匹配任务（arq / Redis） ----
# 排队超过该时间仍未开始，前端提示 worker 异常
TASK_STALL_THRESHOLD_SEC=90
# 任务结果保留时长（秒），超时后清理
TASK_TTL_SEC=3600
# 单个匹配任务最长执行时间（秒），超时判失败
TASK_JOB_TIMEOUT_SEC=600

# Resume PDF storage. Leave empty to keep generated PDFs on local disk.
COS_REGION=
COS_BUCKET=
COS_SECRET_ID=
COS_SECRET_KEY=
RESUME_OUTPUT_DIR=./generated_resumes

# ---- 爬虫（手动触发 / 可接定时任务，见 /crawl） ----
# 抓取结果缓存目录
CRAWLER_CACHE_DIR=.crawler_cache
# 是否遵守 robots.txt（1 遵守 / 0 不遵守，仅调试用）
CRAWLER_OBEY_ROBOTS=1
# 单个来源最多抓取的详情页数量
CRAWL_MAX_DETAIL_PAGES=40
# 以下两个来源留空则用代码内置默认列表；可覆盖为自定义公告页 URL（逗号分隔）
SHENZHENJIAOSHI_LIST_URLS=
SZEB_RYZP_LIST_URLS=

# ---- 备份（scripts/backup_db.py） ----
# 备份产物目录
BACKUP_DIR=./backups
# 保留最近 N 天备份，超出自动清理
BACKUP_KEEP=14
