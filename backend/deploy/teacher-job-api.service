[Unit]
Description=Teacher Job Finder API
After=network.target

[Service]
WorkingDirectory=/opt/teacher-job-api
EnvironmentFile=/opt/teacher-job-api/.env
ExecStart=/opt/teacher-job-api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
