[Unit]
Description=Teacher Job Finder SQLite backup
After=teacher-job-api.service

[Service]
Type=oneshot
WorkingDirectory=/opt/teacher-job-api/backend
EnvironmentFile=/opt/teacher-job-api/backend/.env
ExecStart=/opt/teacher-job-api/backend/.venv/bin/python scripts/backup_db.py --output-dir /opt/teacher-job-api/backend/backups --keep 14
