<view class="job-card" bindtap="onOpen">
  <view class="head">
    <view class="school-wrap">
      <view class="school">{{job.school_name}}</view>
      <view class="meta">{{metaText}}</view>
    </view>
    <view class="pill {{tagClass}}">{{tagText}}</view>
  </view>
  <view class="title">{{job.title}}</view>
  <view class="tag-row">
    <view class="soft-tag">{{job.subject || '学科待确认'}}</view>
    <view class="soft-tag">{{job.stage || '学段待确认'}}</view>
    <view class="soft-tag warn">{{deadlineText}} 截止</view>
    <view class="soft-tag source {{sourceStatusClass}}">{{sourceStatusText}}</view>
  </view>
  <view class="info-grid">
    <view>
      <view class="grid-label">薪资</view>
      <view class="grid-value">{{salaryText}}</view>
    </view>
    <view>
      <view class="grid-label">截止</view>
      <view class="grid-value">{{deadlineText}}</view>
    </view>
    <view>
      <view class="grid-label">人数</view>
      <view class="grid-value">{{headcountText}}人</view>
    </view>
  </view>
  <view wx:if="{{showReason}}" class="reason">
    <view class="score-block">
      <view class="score">{{scoreText}}</view>
      <view class="score-label">匹配度</view>
    </view>
    <view class="reason-body">
      <view class="reason-label">推荐理由</view>
      <view class="reason-text">{{reason}}</view>
    </view>
  </view>
  <view class="actions" catchtap="noop">
    <button class="ghost-btn small" bindtap="onOpen">看详情</button>
    <button class="primary-btn small" bindtap="onApply">{{applyText}}</button>
  </view>
</view>
