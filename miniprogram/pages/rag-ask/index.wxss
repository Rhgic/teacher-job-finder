.qa-hero {
}

.ask-card,
.answer-card,
.sources-card,
.empty-card,
.error-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.field-label {
  color: #1c2030;
  font-size: 27rpx;
  font-weight: 850;
}

.question-input {
  width: 100%;
  min-height: 150rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f8f9fd;
  border: 1rpx solid #e5e7f4;
  color: #1c2030;
  font-size: 26rpx;
  line-height: 1.55;
}

.input-placeholder {
  color: #667089;
}

.ask-btn {
  width: 100%;
  margin-top: 18rpx;
}

.ask-btn.disabled {
  background: #8f9ce0;
  box-shadow: none;
}

.empty-title {
  color: #1c2030;
  font-size: 28rpx;
  font-weight: 850;
}

.empty-desc {
  margin-top: 8rpx;
  color: #667089;
  font-size: 24rpx;
  line-height: 1.5;
}

.example-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.example-chip {
  max-width: 100%;
  padding: 12rpx 16rpx;
  border-radius: 14rpx;
  background: #eaedfb;
  color: #4653f0;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 1.3;
}

.answer-card.not-found {
  background: #fff8ee;
  border-color: #f4ddb9;
}

.error-card {
  background: #fff8ee;
  border-color: #f4ddb9;
}

.error-title {
  color: #a25713;
  font-size: 28rpx;
  font-weight: 850;
}

.error-text {
  margin-top: 8rpx;
  color: #87591f;
  font-size: 24rpx;
  line-height: 1.55;
}

.answer-head,
.source-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.answer-title {
  color: #1c2030;
  font-size: 29rpx;
  font-weight: 850;
}

.answer-text {
  margin-top: 16rpx;
  color: #3a4056;
  font-size: 26rpx;
  line-height: 1.65;
  white-space: pre-wrap;
}

.answer-note {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid rgba(229, 231, 244, 0.9);
  color: #667089;
  font-size: 22rpx;
  line-height: 1.5;
}

.compact {
  margin: 0 0 14rpx;
}

.source-item {
  padding: 18rpx 0;
  border-top: 1rpx solid #eceef7;
}

.source-item:first-of-type {
  border-top: 0;
  padding-top: 2rpx;
}

.source-title {
  flex: 1;
  min-width: 0;
  color: #1c2030;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 1.35;
}

.source-action {
  flex: 0 0 auto;
  color: #4653f0;
  font-size: 22rpx;
  font-weight: 800;
}

.source-snippet {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f6f7fd;
  color: #59617d;
  font-size: 23rpx;
  line-height: 1.55;
  word-break: break-all;
}
