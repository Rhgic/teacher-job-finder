<view class="page">
  <view class="hero-card compare-hero">
    <view class="hero-kicker">岗位对比</view>
    <view class="hero-title">先决定投递顺序</view>
    <view class="hero-subtitle">把收藏岗位放在一起看，优先核对来源完整、截止明确、匹配度更高的机会。</view>
    <view class="compare-badge">{{sourceText}}</view>
  </view>

  <view wx:if="{{bestJob}}" class="best-card" data-id="{{bestJob.id}}" bindtap="openJob">
    <view class="best-label">建议优先核对</view>
    <view class="best-title">{{bestJob.school_name || bestJob.title}}</view>
    <view class="best-meta">{{bestJob.district || '深圳'}} · {{bestJob.stage || '学段待确认'}} · {{bestJob.subject || '学科待确认'}} · {{bestJob.daysLeftText}}</view>
  </view>

  <view class="summary-row">
    <view>
      <view class="summary-title">对比清单</view>
      <view class="muted">最多展示 6 个候选岗位</view>
    </view>
    <button class="ghost-btn mini-action" bindtap="openFavorites">管理收藏</button>
  </view>

  <view class="compare-list">
    <view wx:for="{{jobs}}" wx:key="id" class="compare-card" data-id="{{item.id}}" bindtap="openJob">
      <view class="compare-head">
        <view class="score-box">
          <view class="score-num">{{item.compareScore}}</view>
          <view class="score-label">优先级</view>
        </view>
        <view class="compare-main">
          <view class="compare-title">{{item.school_name || item.title}}</view>
          <view class="compare-meta">{{item.district || '深圳'}} · {{item.stage || '学段待确认'}} · {{item.subject || '学科待确认'}}</view>
        </view>
      </view>
      <view class="field-grid">
        <view class="field">
          <view class="field-label">截止</view>
          <view class="field-value">{{item.deadlineText}}</view>
        </view>
        <view class="field">
          <view class="field-label">剩余</view>
          <view class="field-value">{{item.daysLeftText}}</view>
        </view>
        <view class="field">
          <view class="field-label">性质</view>
          <view class="field-value">{{item.bianzhiText}}</view>
        </view>
      </view>
      <view class="risk-row">
        <view class="source-dot {{item.sourceClass}}"></view>
        <view class="risk-text">{{item.sourceText}} · {{item.riskText}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{isEmpty}}" class="empty">暂无可对比岗位，先收藏几个目标岗位</view>
</view>
