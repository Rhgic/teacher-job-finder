.source-badge {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  z-index: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 850;
}

.form-card {
  margin-bottom: 22rpx;
  padding: 8rpx 26rpx 6rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.field {
  padding: 22rpx 0;
  border-top: 1rpx solid #eceef7;
}

.field:first-child {
  border-top: 0;
}

.label {
  margin-bottom: 12rpx;
  color: #667089;
  font-size: 23rpx;
}

input {
  height: 62rpx;
  color: #1c2030;
  font-size: 28rpx;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.preset-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.preset-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #eff1fc;
  color: #4653f0;
  font-size: 22rpx;
  font-weight: 800;
}

.save-btn {
  width: 100%;
  margin: 0;
}
