<view class="page">
  <view class="hero-card">
    <view class="hero-kicker">岗位订阅</view>
    <view class="hero-title">新岗位别错过</view>
    <view class="hero-subtitle">先把目标条件存下来，正式上线后可接微信订阅消息提醒。</view>
    <view class="source-pill">{{sourceText}}</view>
  </view>

  <button class="primary-btn add-btn" bindtap="addRule">添加订阅规则</button>

  <view class="rule-card" wx:for="{{subscriptions}}" wx:key="id">
    <view class="rule-head">
      <view>
        <view class="rule-name">{{item.name}}</view>
        <view class="muted">{{item.district}} · {{item.stage}} · {{item.subject}}</view>
      </view>
      <view class="switch {{item.enabled ? 'on' : ''}}" data-id="{{item.id}}" bindtap="toggleRule">{{item.enabled ? '开启' : '关闭'}}</view>
    </view>
    <view class="rule-foot">编制要求：{{item.bianzhi}}</view>
  </view>
</view>
