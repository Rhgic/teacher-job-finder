.add-btn {
  width: 100%;
  margin: 0 0 22rpx;
}

.source-pill {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  z-index: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
}

.rule-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.rule-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.rule-name {
  color: #1c2030;
  font-size: 30rpx;
  font-weight: 850;
}

.switch {
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #eceef7;
  color: #626c86;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.switch.on {
  background: #e1f6ec;
  color: #0e8a5f;
}

.rule-foot {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eceef7;
  color: #59617d;
  font-size: 24rpx;
}
