<view class="page">
  <view class="hero-card">
    <view class="hero-kicker">收藏岗位</view>
    <view class="hero-title">先收起来，再慢慢比</view>
    <view class="hero-subtitle">适合把相近学校、相同学科的岗位放在一起筛。</view>
  </view>

  <button class="compare-entry ghost-btn" bindtap="openCompare">进入岗位对比</button>

  <view class="fav-card" wx:for="{{favorites}}" wx:key="id" data-id="{{item.id}}" bindtap="openJob">
    <view class="fav-head">
      <view>
        <view class="school">{{item.school_name}}</view>
        <view class="muted">{{item.district || '深圳'}} · {{item.stage || '学段待确认'}} · {{item.subject || '学科待确认'}}</view>
      </view>
      <view class="pill green">已收藏</view>
    </view>
    <view class="title">{{item.title}}</view>
  </view>

  <view wx:if="{{isEmpty}}" class="empty">还没有收藏岗位，先去岗位详情里点收藏</view>
</view>
