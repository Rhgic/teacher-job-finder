.job-hero {
  min-height: 226rpx;
  padding-right: 156rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.hero-route {
  position: absolute;
  left: 32rpx;
  bottom: 26rpx;
  display: flex;
  gap: 10rpx;
  color: #ffffff;
  font-size: 19rpx;
  font-weight: 900;
  z-index: 1;
}

.hero-route text {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
}

.filter-panel {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 10rpx 26rpx rgba(70, 83, 240, 0.05);
}

.filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.filter-head-main {
  min-width: 0;
  flex: 1;
}

.filter-toggle {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 14rpx;
  background: #f2f3fa;
  color: #4653f0;
  font-size: 22rpx;
  font-weight: 800;
}

.filter-body {
  margin-top: 4rpx;
}

.filter-actions-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.filter-actions-row .mini-btn {
  flex: 1;
  width: auto;
}

.filter-title {
  color: #1c2030;
  font-size: 29rpx;
  font-weight: 850;
}

.chips {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.chip {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #f2f3fa;
  color: #454c66;
  font-size: 23rpx;
  text-align: left;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  border: 1rpx solid #e4e7f3;
  box-sizing: border-box;
}

.chip-label {
  margin-right: 10rpx;
  color: #828ca3;
  font-size: 20rpx;
}

.chip.active {
  color: #0e8a5f;
  background: #e1f6ec;
  font-weight: 700;
  border-color: #b5e6ce;
}

.range-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #fbfcfe;
  border: 1rpx solid #eceef7;
}

.range-copy {
  flex: 1;
  min-width: 0;
}

.range-title {
  color: #1c2030;
  font-size: 24rpx;
  font-weight: 850;
}

.range-control {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  width: 236rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #eceef7;
  box-sizing: border-box;
}

.range-option {
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 999rpx;
  color: #626c86;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}

.range-option.active {
  color: #4653f0;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(70, 83, 240, 0.08);
}

.hero-count {
  position: absolute;
  top: 34rpx;
  right: 30rpx;
  min-width: 96rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  text-align: center;
  z-index: 1;
}

.hero-count-num {
  color: #ffffff;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-count-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.75);
  font-size: 20rpx;
}

.summary-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin: 22rpx 2rpx 16rpx;
}

.summary-title {
  color: #1c2030;
  font-size: 30rpx;
  font-weight: 800;
}

.mini-btn {
  width: 150rpx;
  height: 56rpx;
  margin: 0;
  font-size: 23rpx;
}

.reset-btn {
  width: 112rpx;
  background: #f2f3fa;
  color: #59617d;
}

.save-btn {
  width: 142rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 70rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #f2f3fa;
  border: 1rpx solid #e4e7f3;
  box-sizing: border-box;
}

.search-box input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: #1c2030;
  font-size: 24rpx;
}

.clear {
  flex: 0 0 auto;
  color: #4653f0;
  font-size: 22rpx;
  font-weight: 800;
}

.saved-searches {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eceef7;
}

.saved-title {
  color: #59617d;
  font-size: 22rpx;
  font-weight: 850;
}

.saved-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.saved-chip {
  max-width: 100%;
  padding: 9rpx 12rpx;
  border-radius: 14rpx;
  background: #eaedfb;
  color: #4653f0;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.summary-badge {
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #eaedfb;
  color: #4653f0;
  font-size: 22rpx;
  font-weight: 800;
}

.job-card {
  margin-bottom: 24rpx;
  padding: 28rpx 28rpx 26rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(70, 83, 240, 0.07);
}

.job-card.expired {
  background: #fffaf2;
  border-color: #edd8bb;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.school-wrap {
  min-width: 0;
  flex: 1;
}

.school {
  color: #1c2030;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.job-title {
  margin-top: 16rpx;
  color: #1c2030;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
}

.job-meta {
  margin-top: 8rpx;
  color: #667089;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.job-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.soft-tag {
  max-width: 210rpx;
  padding: 8rpx 12rpx;
  border-radius: 14rpx;
  background: #f2f3fa;
  color: #59617d;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.soft-tag.warn {
  background: #fff2df;
  color: #a25713;
}

.soft-tag.expired-tag {
  background: #f6e2ca;
  color: #87430c;
  font-weight: 850;
}

.expired-hint {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #fff4e7;
  color: #8b4611;
  font-size: 22rpx;
  line-height: 1.5;
}

.soft-tag.source.green {
  background: #e1f6ec;
  color: #0e8a5f;
}

.soft-tag.source.gray {
  background: #eceef7;
  color: #626c86;
}

.soft-tag.source.warn {
  background: #fff2df;
  color: #a25713;
}

.job-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eceef7;
}

.job-stats {
  display: grid;
  grid-template-columns: 1.1fr 0.95fr 1.1fr;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.stat {
  min-width: 0;
}

.stat-label {
  color: #707a93;
  font-size: 20rpx;
}

.stat-value {
  margin-top: 6rpx;
  color: #1c2030;
  font-size: 25rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.action-stat {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 128rpx;
  flex: 0 0 128rpx;
  box-sizing: border-box;
}

.small-btn {
  width: 128rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
}
