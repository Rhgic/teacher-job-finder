.job-hero {
  min-height: 226rpx;
  padding-right: 156rpx;
}

.hero-copy {
  position: relative;
  z-index: 1;
}

.hero-route {
  position: absolute;
  left: 28rpx;
  bottom: 22rpx;
  display: flex;
  gap: 8rpx;
  color: rgba(20, 96, 79, 0.78);
  font-size: 19rpx;
  font-weight: 900;
}

.hero-route text {
  padding: 6rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(20, 96, 79, 0.1);
}

.filter-panel {
  margin-bottom: 24rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  box-shadow: 0 10rpx 26rpx rgba(26, 52, 45, 0.05);
}

.filter-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
}

.filter-head-main {
  min-width: 0;
  flex: 1;
}

.filter-toggle {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #f4f7f3;
  color: #14604f;
  font-size: 22rpx;
  font-weight: 800;
}

.filter-body {
  margin-top: 4rpx;
}

.filter-actions-row {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.filter-actions-row .mini-btn {
  flex: 1;
  width: auto;
}

.filter-title {
  color: #15231f;
  font-size: 29rpx;
  font-weight: 850;
}

.chips {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.chip {
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f4f7f3;
  color: #40524b;
  font-size: 23rpx;
  text-align: left;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  border: 1rpx solid #e4ebe5;
  box-sizing: border-box;
}

.chip-label {
  margin-right: 10rpx;
  color: #829089;
  font-size: 20rpx;
}

.chip.active {
  color: #176238;
  background: #e4f3e9;
  font-weight: 700;
  border-color: #b9dec6;
}

.range-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-top: 18rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #fbfcfa;
  border: 1rpx solid #edf1ee;
}

.range-copy {
  flex: 1;
  min-width: 0;
}

.range-title {
  color: #15231f;
  font-size: 24rpx;
  font-weight: 850;
}

.range-control {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  width: 236rpx;
  padding: 4rpx;
  border-radius: 9rpx;
  background: #edf1ee;
  box-sizing: border-box;
}

.range-option {
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 7rpx;
  color: #61706a;
  font-size: 20rpx;
  font-weight: 800;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
}

.range-option.active {
  color: #14604f;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(26, 52, 45, 0.08);
}

.hero-count {
  position: absolute;
  top: 30rpx;
  right: 24rpx;
  width: 96rpx;
  text-align: right;
}

.hero-count-num {
  color: #14604f;
  font-size: 46rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-count-label {
  margin-top: 6rpx;
  color: #728079;
  font-size: 20rpx;
}

.summary-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin: 22rpx 2rpx 16rpx;
}

.summary-title {
  color: #15231f;
  font-size: 30rpx;
  font-weight: 800;
}

.mini-btn {
  width: 150rpx;
  height: 56rpx;
  margin: 0;
  font-size: 23rpx;
}

.reset-btn {
  width: 112rpx;
  background: #f4f7f3;
  color: #52645d;
}

.save-btn {
  width: 142rpx;
}

.search-box {
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 70rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f4f7f3;
  border: 1rpx solid #e4ebe5;
  box-sizing: border-box;
}

.search-box input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  color: #15231f;
  font-size: 24rpx;
}

.clear {
  flex: 0 0 auto;
  color: #14604f;
  font-size: 22rpx;
  font-weight: 800;
}

.saved-searches {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ee;
}

.saved-title {
  color: #52645d;
  font-size: 22rpx;
  font-weight: 850;
}

.saved-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.saved-chip {
  max-width: 100%;
  padding: 9rpx 12rpx;
  border-radius: 8rpx;
  background: #e7f1ee;
  color: #14604f;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.summary-badge {
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  background: #e7f1ee;
  color: #14604f;
  font-size: 22rpx;
  font-weight: 800;
}

.job-card {
  margin-bottom: 22rpx;
  padding: 26rpx 26rpx 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  box-shadow: 0 12rpx 28rpx rgba(26, 52, 45, 0.06);
}

.job-card.expired {
  background: #fffaf2;
  border-color: #edd8bb;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.school-wrap {
  min-width: 0;
  flex: 1;
}

.school {
  color: #15231f;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.35;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.job-title {
  margin-top: 16rpx;
  color: #15231f;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.45;
}

.job-meta {
  margin-top: 8rpx;
  color: #66736d;
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.job-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.soft-tag {
  max-width: 210rpx;
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  background: #f4f7f3;
  color: #52645d;
  font-size: 21rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.soft-tag.warn {
  background: #fff2df;
  color: #a25713;
}

.soft-tag.expired-tag {
  background: #f6e2ca;
  color: #87430c;
  font-weight: 850;
}

.expired-hint {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 9rpx;
  background: #fff4e7;
  color: #8b4611;
  font-size: 22rpx;
  line-height: 1.5;
}

.soft-tag.source.green {
  background: #e4f3e9;
  color: #176238;
}

.soft-tag.source.gray {
  background: #edf1ef;
  color: #61706a;
}

.soft-tag.source.warn {
  background: #fff2df;
  color: #a25713;
}

.job-footer {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ee;
}

.job-stats {
  display: grid;
  grid-template-columns: 1.1fr 0.95fr 1.1fr;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.stat {
  min-width: 0;
}

.stat-label {
  color: #6f7c76;
  font-size: 20rpx;
}

.stat-value {
  margin-top: 6rpx;
  color: #15231f;
  font-size: 25rpx;
  font-weight: 800;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.action-stat {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 128rpx;
  flex: 0 0 128rpx;
  box-sizing: border-box;
}

.small-btn {
  width: 128rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border-radius: 9rpx;
  font-size: 23rpx;
}
