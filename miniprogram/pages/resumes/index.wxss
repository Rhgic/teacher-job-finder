.actions-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.source-pill {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  z-index: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 800;
}

.action {
  width: 100%;
  margin: 0;
  font-size: 25rpx;
}

.upload-tip {
  width: 100%;
  height: 58rpx;
  margin: -6rpx 0 22rpx;
  font-size: 23rpx;
}

.edit-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.form-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 22rpx;
}

.form-title {
  color: #1c2030;
  font-size: 29rpx;
  font-weight: 850;
}

.text-btn {
  width: 140rpx;
  height: 52rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: #f2f3fa;
  color: #59617d;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 52rpx;
}

.text-btn::after {
  border: 0;
}

.edit-card .field {
  margin-bottom: 22rpx;
}

.edit-card .label {
  margin-bottom: 10rpx;
  color: #59617d;
  font-size: 24rpx;
  font-weight: 800;
}

.edit-card input,
.edit-card textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f7f7fa;
  border: 1rpx solid #e5e7f4;
  color: #1c2030;
  font-size: 25rpx;
}

.edit-card input {
  height: 72rpx;
  padding: 0 18rpx;
}

.edit-card textarea {
  min-height: 180rpx;
  padding: 16rpx 18rpx;
  line-height: 1.5;
}

.full-action {
  width: 100%;
  margin: 0;
}

.resume-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.resume-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
}

.resume-name {
  color: #1c2030;
  font-size: 30rpx;
  font-weight: 850;
}

.score {
  color: #4653f0;
  font-size: 34rpx;
  font-weight: 900;
}

.progress {
  height: 12rpx;
  margin-top: 20rpx;
  border-radius: 999rpx;
  background: #eceef7;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  border-radius: 999rpx;
  background: #4653f0;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.soft-tag {
  padding: 8rpx 12rpx;
  border-radius: 14rpx;
  background: #f2f3fa;
  color: #59617d;
  font-size: 21rpx;
}

.card-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #eceef7;
}

.card-btn {
  flex: 1;
  min-width: 0;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 9rpx;
  font-size: 23rpx;
  line-height: 58rpx;
}

.delete-btn {
  background: #fff8ee;
  color: #b42318;
  border: 1rpx solid #f4ddb9;
  font-weight: 850;
}

.delete-btn::after {
  border: 0;
}
