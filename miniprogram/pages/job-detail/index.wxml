<view class="page">
  <view class="hero-card detail-hero">
    <view class="hero-kicker">岗位核对</view>
    <view class="title">{{job.title}}</view>
    <view class="meta">{{metaText}}</view>
    <view class="tags">
      <view class="pill {{tagClass}}">{{tagText}}</view>
      <view class="pill gray">{{salaryText}}</view>
      <view class="pill gray">{{headcountText}}人</view>
    </view>
  </view>

  <view wx:if="{{isExpired}}" class="expired-banner">
    <view class="expired-title">这个岗位已过截止日期</view>
    <view>建议只作为历史参考。投递前请回官方公告确认是否延期或补报名。</view>
  </view>

  <view class="metric-row detail-metrics">
    <view class="metric-box">
      <view class="metric-label">薪资</view>
      <view class="metric-value">{{salaryText}}</view>
    </view>
    <view class="metric-box">
      <view class="metric-label">截止</view>
      <view class="metric-value">{{deadlineText}}</view>
    </view>
    <view class="metric-box">
      <view class="metric-label">人数</view>
      <view class="metric-value">{{headcountText}}</view>
    </view>
  </view>

  <view class="check-card">
    <view class="check-title">投递前先核对</view>
    <view class="check-list">
      <view class="check-item"><text class="check-dot"></text><text>公告来源是否可信</text></view>
      <view class="check-item"><text class="check-dot"></text><text>岗位条件是否符合你的证书和学段</text></view>
      <view class="check-item"><text class="check-dot"></text><text>简历和求职信是否针对本岗位调整</text></view>
    </view>
  </view>

  <view class="card source-card">
    <view class="source-head">
      <view>
        <view class="section-title compact">来源核验</view>
        <view class="source-host">{{sourceHostText}}</view>
      </view>
      <view class="pill {{sourceStatusClass}}">{{sourceStatusText}}</view>
    </view>
    <view class="source-text">{{sourceText}}</view>
    <view class="source-status-row">
      <view class="status-chip">{{emailRiskText}}</view>
      <view class="status-chip">{{deadlineRiskText}}</view>
    </view>
    <view class="risk-list">
      <view wx:for="{{riskTips}}" wx:key="*this" class="risk-item">
        <text class="risk-mark"></text>
        <text>{{item}}</text>
      </view>
    </view>
    <view class="source-actions">
      <button class="source-copy" bindtap="copySource">复制公告信息</button>
      <button class="source-copy guide" bindtap="goSourceGuide">查看核验规则</button>
    </view>
  </view>

  <view class="detail-actions">
    <button class="ghost-btn action-btn" bindtap="toggleFavorite">{{favoriteText}}</button>
    <button class="ghost-btn action-btn" bindtap="subscribeSimilar">订阅类似</button>
    <button class="ghost-btn action-btn" bindtap="goInterviewPrep">面试准备</button>
    <button class="ghost-btn action-btn" bindtap="goSchoolProfile">学校画像</button>
  </view>

  <view class="card">
    <view class="section-title compact">岗位说明</view>
    <view class="jd">{{job.jd}}</view>
    <view wx:if="{{job.source_url}}" class="source-link">来源：{{job.source_url}}</view>
  </view>

  <view class="card">
    <view class="section-title compact">投递信息</view>
    <view class="row"><text>招聘邮箱</text><text>{{emailText}}</text></view>
    <view class="row"><text>截止日期</text><text>{{deadlineText}}</text></view>
    <view class="row"><text>投递方式</text><text>你确认后再投递</text></view>
  </view>

  <view class="bottom-space"></view>
  <view class="bottom-bar">
    <button class="primary-btn {{isExpired ? 'expired-btn' : ''}}" bindtap="goApply">{{applyButtonText}}</button>
  </view>
</view>
