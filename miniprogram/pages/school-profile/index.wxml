<view class="page">
  <view class="hero-card school-hero">
    <view class="hero-kicker">学校画像</view>
    <view class="hero-title">{{schoolName}}</view>
    <view class="hero-subtitle">{{districtText}} · {{stageText}} · {{subjectText}}</view>
  </view>

  <view class="metric-row school-metrics">
    <view class="metric-box">
      <view class="metric-label">岗位</view>
      <view class="metric-value">{{jobCount}}</view>
    </view>
    <view class="metric-box">
      <view class="metric-label">编制</view>
      <view class="metric-value">{{establishmentCount}}</view>
    </view>
    <view class="metric-box">
      <view class="metric-label">有来源</view>
      <view class="metric-value">{{sourceReadyCount}}</view>
    </view>
  </view>

  <view class="profile-card">
    <view class="section-title compact">画像摘要</view>
    <view class="row"><text>所在区域</text><text>{{districtText}}</text></view>
    <view class="row"><text>覆盖学段</text><text>{{stageText}}</text></view>
    <view class="row"><text>招聘学科</text><text>{{subjectText}}</text></view>
  </view>

  <view class="section-title">该校岗位</view>
  <view wx:for="{{jobs}}" wx:key="id" class="job-card" data-id="{{item.id}}" bindtap="openJob">
    <view class="job-head">
      <view class="job-title">{{item.title}}</view>
      <view class="pill {{item.sourceStatusClass}}">{{item.sourceStatusText}}</view>
    </view>
    <view class="job-meta">{{item.stage || '学段待确认'}} · {{item.subject || '学科待确认'}} · {{item.deadlineText}}</view>
  </view>

  <view wx:if="{{empty}}" class="empty">暂时没有找到这个学校的岗位</view>
</view>
