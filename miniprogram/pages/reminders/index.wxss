.reminder-hero {
  padding-right: 176rpx;
}

.alert-badge {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  z-index: 1;
  max-width: 142rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 850;
  text-align: center;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.alert-badge.hot {
  background: #ffca7a;
  border-color: #ffca7a;
  color: #7e3a06;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-bottom: 22rpx;
}

.summary-card {
  min-width: 0;
  padding: 18rpx 12rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  text-align: center;
}

.summary-num {
  color: #4653f0;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.1;
}

.summary-label {
  margin-top: 8rpx;
  color: #707a93;
  font-size: 21rpx;
}

.preference-line {
  margin: -4rpx 2rpx 18rpx;
  color: #7e88a0;
  font-size: 22rpx;
  line-height: 1.4;
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 104rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.05);
}

.task-card.urgent {
  border-color: #f0c78a;
  background: #fffaf1;
}

.task-mark {
  width: 16rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: #4653f0;
  flex: 0 0 16rpx;
}

.task-card.urgent .task-mark {
  background: #c5681c;
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-title {
  color: #1c2030;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.3;
}

.task-desc {
  margin-top: 8rpx;
  color: #667089;
  font-size: 23rpx;
  line-height: 1.45;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.task-action {
  flex: 0 0 104rpx;
  min-width: 104rpx;
  padding: 9rpx 10rpx;
  border-radius: 14rpx;
  background: #eaedfb;
  color: #4653f0;
  font-size: 22rpx;
  font-weight: 850;
  text-align: center;
}
