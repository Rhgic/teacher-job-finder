<view class="page">
  <view class="hero-card">
    <view class="hero-kicker">上线检查</view>
    <view class="hero-title">服务器状态</view>
    <view class="hero-subtitle">这里只显示是否配置完成，不展示任何密钥内容。</view>
    <view class="status-pill {{statusClass}}">{{statusText}}</view>
  </view>

  <view class="status-card">
    <view class="section-title compact">后端数据</view>
    <view class="metric-line">
      <view>
        <view class="metric-num">{{jobsCount}}</view>
        <view class="metric-label">岗位</view>
      </view>
      <view>
        <view class="metric-num">{{activeRulesCount}}</view>
        <view class="metric-label">活跃规则</view>
      </view>
    </view>
    <view class="latest">最新岗位时间：{{latestJobAt}}</view>
  </view>

  <view class="status-card">
    <view class="card-head">
      <view class="section-title compact">数据备份</view>
      <view class="small-pill {{backupOk ? 'green' : 'warn'}}">{{backupOk ? '已备份' : '待备份'}}</view>
    </view>
    <view class="backup-grid">
      <view>
        <view class="metric-num">{{backupCount}}</view>
        <view class="metric-label">备份份数</view>
      </view>
      <view>
        <view class="metric-num small">{{backupLatestSize}}</view>
        <view class="metric-label">最近大小</view>
      </view>
    </view>
    <view class="latest">最近备份时间：{{backupLatestAt}}</view>
    <view class="latest muted">最近备份文件：{{backupLatestFile}}</view>
  </view>

  <view class="status-card">
    <view class="section-title compact">正式上线必填</view>
    <view wx:for="{{requiredItems}}" wx:key="key" class="check-row">
      <view class="check-dot {{item.ok ? 'ok' : ''}}"></view>
      <view class="check-label">{{item.label}}</view>
      <view class="check-text {{item.ok ? 'ok' : ''}}">{{item.text}}</view>
    </view>
  </view>

  <view class="status-card">
    <view class="section-title compact">可选增强</view>
    <view wx:for="{{optionalItems}}" wx:key="key" class="check-row">
      <view class="check-dot {{item.ok ? 'ok' : ''}}"></view>
      <view class="check-label">{{item.label}}</view>
      <view class="check-text {{item.ok ? 'ok' : ''}}">{{item.text}}</view>
    </view>
  </view>

  <view class="next-card">
    <view class="next-title">下一步</view>
    <view class="next-text">{{nextStep}}</view>
  </view>
</view>
