.status-pill {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  z-index: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 850;
}

.status-pill.green {
  background: #ffffff;
  border-color: #ffffff;
  color: #0e8a5f;
}

.status-pill.warn {
  background: #ffca7a;
  border-color: #ffca7a;
  color: #7e3a06;
}

.status-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.card-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.compact {
  margin: 0 0 14rpx;
}

.metric-line,
.backup-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.metric-line > view,
.backup-grid > view {
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f6f7fd;
  border: 1rpx solid #e4e7f3;
}

.metric-num {
  color: #4653f0;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.metric-num.small {
  font-size: 28rpx;
  line-height: 1.2;
}

.metric-label {
  margin-top: 8rpx;
  color: #667089;
  font-size: 22rpx;
}

.latest {
  margin-top: 16rpx;
  color: #59617d;
  font-size: 24rpx;
}

.latest.muted {
  margin-top: 8rpx;
  color: #7e88a0;
  font-size: 22rpx;
  word-break: break-all;
}

.small-pill {
  flex: 0 0 auto;
  margin-left: auto;
  padding: 7rpx 12rpx;
  border-radius: 14rpx;
  background: #eceef7;
  color: #626c86;
  font-size: 21rpx;
  font-weight: 850;
}

.small-pill.green {
  background: #e1f6ec;
  color: #0e8a5f;
}

.small-pill.warn {
  background: #fff2df;
  color: #a25713;
}

.check-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 56rpx;
  border-top: 1rpx solid #eceef7;
}

.check-row:first-of-type {
  border-top: 0;
}

.check-dot {
  width: 15rpx;
  height: 15rpx;
  border-radius: 50%;
  background: #dcdfec;
  flex: 0 0 15rpx;
}

.check-dot.ok {
  background: #4653f0;
}

.check-label {
  flex: 1;
  min-width: 0;
  color: #1c2030;
  font-size: 25rpx;
  font-weight: 750;
}

.check-text {
  flex: 0 0 auto;
  color: #a25713;
  font-size: 23rpx;
  font-weight: 800;
}

.check-text.ok {
  color: #0e8a5f;
}

.next-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff8ee;
  border: 1rpx solid #f4ddb9;
}

.next-title {
  color: #a25713;
  font-size: 27rpx;
  font-weight: 850;
}

.next-text {
  margin-top: 8rpx;
  color: #87591f;
  font-size: 24rpx;
  line-height: 1.6;
}
