.applications-hero {
  min-height: 190rpx;
}

.rail-label {
  position: absolute;
  right: 28rpx;
  bottom: 24rpx;
  color: rgba(255, 255, 255, 0.35);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.status-strip {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin-bottom: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #2c34a3;
  color: #ffffff;
}

.strip-num {
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1;
}

.small-num {
  font-size: 32rpx;
}

.strip-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 21rpx;
}

.strip-divider {
  width: 1rpx;
  height: 62rpx;
  background: rgba(255, 255, 255, 0.16);
}

.strip-copy {
  flex: 1;
  color: #667089;
  font-size: 24rpx;
  line-height: 1.5;
}

.tip-card {
  margin-bottom: 24rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fff8ee;
  border: 1rpx solid #f4ddb9;
}

.record-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #1c2030;
}

.timeline {
  position: relative;
  margin-top: 4rpx;
  padding-left: 24rpx;
}

.timeline-line {
  position: absolute;
  left: 8rpx;
  top: 8rpx;
  bottom: 26rpx;
  width: 2rpx;
  background: #dde1f1;
}

.record {
  position: relative;
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.timeline-dot {
  position: absolute;
  left: -23rpx;
  top: 34rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #4653f0;
  border: 6rpx solid #f4f5fb;
}

.record-email {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.record-title {
  margin-bottom: 10rpx;
  color: #1c2030;
  font-size: 26rpx;
  font-weight: 750;
  line-height: 1.45;
}

.record-meta {
  color: #667089;
  font-size: 24rpx;
  line-height: 1.5;
}

.record-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.status-btn {
  width: 168rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 9rpx;
  background: #eaedfb;
  color: #4653f0;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 58rpx;
}

.status-btn::after {
  border: 0;
}

.note-btn {
  background: #f4efe3;
  color: #8a5c1d;
}

.note-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 14rpx;
}

.note-item {
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  background: #f6f7fd;
  color: #565e7a;
  font-size: 22rpx;
  line-height: 1.45;
}
