.calendar-hero {
  padding-right: 130rpx;
}

.count-pill {
  position: absolute;
  right: 24rpx;
  top: 30rpx;
  z-index: 1;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: #e4f3e9;
  color: #176238;
  font-size: 22rpx;
  font-weight: 900;
}

.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  box-shadow: 0 12rpx 28rpx rgba(26, 52, 45, 0.06);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.section-name {
  color: #15231f;
  font-size: 30rpx;
  font-weight: 850;
}

.num {
  min-width: 48rpx;
  color: #14604f;
  font-size: 34rpx;
  font-weight: 900;
  text-align: right;
}

.job-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #edf1ee;
}

.job-row.urgent {
  background: linear-gradient(90deg, rgba(255, 248, 238, 0.92), rgba(255, 255, 255, 0));
}

.job-title {
  color: #15231f;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}

.days {
  flex: 0 0 auto;
  padding: 9rpx 12rpx;
  border-radius: 8rpx;
  background: #fff2df;
  color: #a25713;
  font-size: 22rpx;
  font-weight: 900;
}

.days.gray {
  background: #edf1ef;
  color: #61706a;
}

.empty-mini {
  padding: 24rpx 0 6rpx;
  color: #66736d;
  font-size: 24rpx;
  text-align: center;
  border-top: 1rpx solid #edf1ee;
}
