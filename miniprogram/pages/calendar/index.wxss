.calendar-hero {
  padding-right: 130rpx;
}

.count-pill {
  position: absolute;
  right: 24rpx;
  top: 30rpx;
  z-index: 1;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 900;
}

.section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.section-name {
  color: #1c2030;
  font-size: 30rpx;
  font-weight: 850;
}

.num {
  min-width: 48rpx;
  color: #4653f0;
  font-size: 34rpx;
  font-weight: 900;
  text-align: right;
}

.job-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #eceef7;
}

.job-row.urgent {
  background: linear-gradient(90deg, rgba(255, 248, 238, 0.92), rgba(255, 255, 255, 0));
}

.job-title {
  color: #1c2030;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.4;
}

.days {
  flex: 0 0 auto;
  padding: 9rpx 12rpx;
  border-radius: 14rpx;
  background: #fff2df;
  color: #a25713;
  font-size: 22rpx;
  font-weight: 900;
}

.days.gray {
  background: #eceef7;
  color: #626c86;
}

.empty-mini {
  padding: 24rpx 0 6rpx;
  color: #667089;
  font-size: 24rpx;
  text-align: center;
  border-top: 1rpx solid #eceef7;
}
