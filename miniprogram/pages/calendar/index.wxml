<view class="page">
  <view class="hero-card calendar-hero">
    <view class="hero-kicker">求职日历</view>
    <view class="hero-title">别错过截止日</view>
    <view class="hero-subtitle">把快截止和近期岗位拎出来，先处理材料和公告核对。</view>
    <view class="count-pill">{{totalCount}} 个</view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-name">7 天内截止</view>
        <view class="muted">建议优先核对附件和投递方式</view>
      </view>
      <view class="num">{{urgentJobs.length}}</view>
    </view>
    <view class="job-row urgent" wx:for="{{urgentJobs}}" wx:key="id" data-id="{{item.id}}" bindtap="openJob">
      <view>
        <view class="job-title">{{item.school_name}}</view>
        <view class="muted">{{item.stage}} · {{item.subject}} · {{item.deadlineText}}</view>
      </view>
      <view class="days">{{item.daysLeftText}}</view>
    </view>
    <view wx:if="{{urgentJobs.length === 0}}" class="empty-mini">暂无快截止岗位</view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-name">30 天内截止</view>
        <view class="muted">可以加入准备队列</view>
      </view>
      <view class="num">{{upcomingJobs.length}}</view>
    </view>
    <view class="job-row" wx:for="{{upcomingJobs}}" wx:key="id" data-id="{{item.id}}" bindtap="openJob">
      <view>
        <view class="job-title">{{item.school_name}}</view>
        <view class="muted">{{item.stage}} · {{item.subject}} · {{item.deadlineText}}</view>
      </view>
      <view class="days">{{item.daysLeftText}}</view>
    </view>
    <view wx:if="{{upcomingJobs.length === 0}}" class="empty-mini">暂无近期截止岗位</view>
  </view>

  <view class="section">
    <view class="section-head">
      <view>
        <view class="section-name">截止待确认</view>
        <view class="muted">需要回到公告原文确认</view>
      </view>
      <view class="num">{{unknownJobs.length}}</view>
    </view>
    <view class="job-row" wx:for="{{unknownJobs}}" wx:key="id" data-id="{{item.id}}" bindtap="openJob">
      <view>
        <view class="job-title">{{item.school_name}}</view>
        <view class="muted">{{item.stage}} · {{item.subject}}</view>
      </view>
      <view class="days gray">待定</view>
    </view>
  </view>
</view>
