<view class="page">
  <view class="hero-card">
    <view class="hero-kicker">面试准备</view>
    <view class="hero-title">{{job.subject || '教师'}}岗位准备包</view>
    <view class="hero-subtitle">{{metaText}}</view>
  </view>

  <view class="prep-card">
    <view class="card-title">试讲/说课方向</view>
    <view class="prep-item" wx:for="{{trialTopics}}" wx:key="*this">
      <view class="item-index">{{index + 1}}</view>
      <view class="item-text">{{item}}</view>
    </view>
  </view>

  <view class="prep-card">
    <view class="card-title">结构化面试问题</view>
    <view class="prep-item" wx:for="{{interviewQuestions}}" wx:key="*this">
      <view class="item-index">问</view>
      <view class="item-text">{{item}}</view>
    </view>
  </view>

  <view class="prep-card warn">
    <view class="card-title">材料核对清单</view>
    <view class="prep-item" wx:for="{{materialChecklist}}" wx:key="*this">
      <view class="item-index">核</view>
      <view class="item-text">{{item}}</view>
    </view>
  </view>
</view>
