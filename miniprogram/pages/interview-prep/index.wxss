.prep-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.prep-card.warn {
  background: #fff8ee;
  border-color: #f4ddb9;
}

.card-title {
  margin-bottom: 18rpx;
  color: #1c2030;
  font-size: 30rpx;
  font-weight: 850;
}

.prep-item {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  padding: 16rpx 0;
  border-top: 1rpx solid #eceef7;
}

.prep-item:first-of-type {
  border-top: 0;
}

.item-index {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42rpx;
  height: 42rpx;
  flex: 0 0 42rpx;
  border-radius: 9rpx;
  background: #e1f6ec;
  color: #0e8a5f;
  font-size: 21rpx;
  font-weight: 900;
}

.item-text {
  flex: 1;
  min-width: 0;
  color: #454c66;
  font-size: 25rpx;
  line-height: 1.6;
}
