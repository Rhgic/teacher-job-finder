<view class="page">
  <view class="hero-card profile">
    <view class="avatar">师</view>
    <view class="profile-copy">
      <view class="hero-kicker">求职档案</view>
      <view class="name">{{nameText}}</view>
      <view class="hero-subtitle">{{emailText}}</view>
    </view>
    <view class="login-badge {{isLoggedIn ? 'on' : ''}}">{{isLoggedIn ? '已登录' : '未登录'}}</view>
  </view>

  <view class="login-card">
    <view>
      <view class="login-title">{{isLoggedIn ? '微信登录已启用' : '使用微信快速登录'}}</view>
      <view class="login-desc">{{isLoggedIn ? '后续会用这个登录态保存你的目标、简历和投递记录。' : '和常见小程序一样，点一下就能绑定当前微信身份。'}}</view>
    </view>
    <button wx:if="{{!isLoggedIn}}" class="primary-btn login-btn" loading="{{loginLoading}}" bindtap="handleWechatLogin">微信登录</button>
    <button wx:else class="ghost-btn login-btn" bindtap="handleLogout">退出</button>
  </view>

  <view wx:if="{{!onboardingHidden && onboardingProgress < onboardingTotal}}" class="onboarding-card">
    <view class="onboarding-head">
      <view>
        <view class="onboarding-title">新手求职准备</view>
        <view class="onboarding-desc">先完成这几步，后面推荐、公告核对和投递会顺很多。</view>
      </view>
      <button class="onboarding-hide" bindtap="hideOnboarding">收起</button>
    </view>
    <view class="onboarding-progress">
      <view class="onboarding-count">{{onboardingProgress}}/{{onboardingTotal}}</view>
      <view class="onboarding-track">
        <view class="onboarding-fill" style="width: {{onboardingProgressPercent}}%;"></view>
      </view>
    </view>
    <view class="onboarding-list">
      <view wx:for="{{onboardingItems}}" wx:key="label" class="onboarding-step {{item.done ? 'done' : ''}}" data-url="{{item.url}}" bindtap="openOnboardingStep">
        <view class="step-mark">{{item.done ? '✓' : index + 1}}</view>
        <view class="step-copy">
          <view class="step-title">{{item.label}}</view>
          <view class="step-desc">{{item.desc}}</view>
        </view>
      </view>
    </view>
    <button class="primary-btn onboarding-btn" bindtap="openOnboardingNext">{{onboardingNextText}}</button>
  </view>

  <view class="quick-grid">
    <view class="quick-card">
      <view class="quick-value">深圳</view>
      <view class="quick-label">求职城市</view>
    </view>
    <view class="quick-card">
      <view class="quick-value">教师</view>
      <view class="quick-label">岗位方向</view>
    </view>
    <view class="quick-card">
      <view class="quick-value">确认制</view>
      <view class="quick-label">投递方式</view>
    </view>
  </view>

  <view class="ready-card">
    <view class="ready-head">
      <view>
        <view class="section-title compact">资料准备度</view>
        <view class="ready-desc">先把求职方向和简历信息补完整，再让 AI 去匹配岗位</view>
      </view>
      <view class="ready-score">{{readyScore}}%</view>
    </view>
    <view class="ready-bar">
      <view class="ready-fill" style="width: {{readyScore}}%;"></view>
    </view>
    <view class="ready-list">
      <view wx:for="{{readyItems}}" wx:key="label" class="ready-item">
        <view class="ready-dot {{item.done ? 'done' : ''}}"></view>
        <view class="ready-label">{{item.label}}</view>
        <view class="ready-text">{{item.text}}</view>
      </view>
    </view>
    <view class="ready-actions">
      <button class="ghost-btn ready-btn" bindtap="openProfileEdit">编辑档案</button>
      <button class="ghost-btn ready-btn" bindtap="openResumeCenter">补充简历</button>
      <button class="primary-btn ready-btn" bindtap="openRecommend">AI 匹配</button>
    </view>
  </view>

  <view class="feature-grid">
    <view class="feature-card" data-url="/pages/materials/index" bindtap="openFeature">
      <view class="feature-icon">材</view>
      <view class="feature-title">材料清单</view>
    </view>
    <view class="feature-card" data-url="/pages/favorites/index" bindtap="openFeature">
      <view class="feature-icon">藏</view>
      <view class="feature-title">收藏岗位</view>
    </view>
    <view class="feature-card" data-url="/pages/about/index" bindtap="openFeature">
      <view class="feature-icon">规</view>
      <view class="feature-title">关于与隐私</view>
    </view>
    <view wx:if="{{isDev}}" class="feature-card" data-url="/pages/server-status/index" bindtap="openFeature">
      <view class="feature-icon">服</view>
      <view class="feature-title">服务器状态</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title compact">我的目标</view>
    <view class="row"><text>区域</text><text>{{districts}}</text></view>
    <view class="row"><text>学段</text><text>{{stages}}</text></view>
    <view class="row"><text>学科</text><text>{{subjects}}</text></view>
  </view>

  <view class="card">
    <view class="section-title compact">简历与求职信</view>
    <view class="row"><text>默认简历</text><text>深圳教师求职简历</text></view>
    <view class="row"><text>求职信模板</text><text>标准求职信</text></view>
    <button class="ghost-btn full" bindtap="showUploadTip">更新简历</button>
  </view>

  <view class="safety-card">
    <view class="safety-title">投递规则</view>
    <view class="safety-text">简历改写只允许重组和突出真实经历；每一次投递都需要你确认。</view>
  </view>
</view>
