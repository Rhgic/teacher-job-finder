.materials-hero {
  padding-right: 120rpx;
}

.progress-badge {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  z-index: 1;
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  background: #ffffff;
  color: #4653f0;
  box-shadow: 0 8rpx 20rpx rgba(28, 32, 90, 0.25);
  font-size: 23rpx;
  font-weight: 900;
  text-align: center;
}

.progress-card,
.material-section {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.progress-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.progress-title {
  color: #1c2030;
  font-size: 28rpx;
  font-weight: 850;
}

.mini-btn {
  width: 112rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  background: #eaedfb;
  color: #4653f0;
  font-size: 23rpx;
  font-weight: 850;
}

.ready-bar {
  height: 12rpx;
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #eceef7;
  overflow: hidden;
}

.ready-fill {
  height: 12rpx;
  border-radius: 999rpx;
  background: #4653f0;
}

.section-name {
  margin-bottom: 10rpx;
  color: #1c2030;
  font-size: 28rpx;
  font-weight: 850;
}

.material-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  min-height: 66rpx;
  border-top: 1rpx solid #eceef7;
}

.material-row:first-of-type {
  border-top: 0;
}

.check-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
  border-radius: 14rpx;
  border: 2rpx solid #cbd1e6;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 900;
  flex: 0 0 34rpx;
}

.check-box.checked {
  border-color: #4653f0;
  background: #4653f0;
}

.material-name {
  flex: 1;
  min-width: 0;
  color: #2a2f45;
  font-size: 25rpx;
  line-height: 1.45;
}
