.confirm-hero {
}

.target-card {
  border-left: 8rpx solid #4653f0;
}

.compact {
  margin: 0 0 12rpx;
}

.job-name {
  margin-bottom: 10rpx;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.45;
  color: #1c2030;
}

.verify-card {
  padding-bottom: 24rpx;
}

.verify-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.verify-chip {
  min-height: 44rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eff1fc;
  color: #3a44c9;
  font-size: 22rpx;
  line-height: 28rpx;
  box-sizing: border-box;
}

.expired-notice {
  margin-bottom: 22rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff4e7;
  border: 1rpx solid #f3d2a8;
  color: #9a4d10;
  font-size: 24rpx;
  line-height: 1.6;
}

.expired-title {
  margin-bottom: 4rpx;
  color: #7a3609;
  font-size: 27rpx;
  font-weight: 850;
}

.select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #eceef7;
  line-height: 1.45;
}

.select-row text:first-child {
  color: #667089;
  flex: 0 0 100rpx;
}

.select-row text:nth-child(2) {
  flex: 1;
  min-width: 0;
  text-align: right;
  color: #1c2030;
  font-weight: 700;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.arrow {
  flex: 0 0 auto;
  color: #9aa2b8;
  font-size: 34rpx;
  line-height: 1;
}

.primary-btn {
  width: 100%;
  margin: 0;
  padding: 0;
  text-align: center;
}

textarea {
  width: 100%;
  min-height: 260rpx;
  color: #3a4056;
  font-size: 26rpx;
  line-height: 1.7;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  background: #f7f8fd;
  border: 1rpx solid #e5e7f4;
}

.checklist-card {
  padding-bottom: 18rpx;
}

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #eceef7;
}

.check-row:first-of-type {
  border-top: 0;
}

.check-box {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  margin-top: 4rpx;
  border-radius: 14rpx;
  border: 2rpx solid #b7bdd1;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.check-row.done .check-box {
  background: #4653f0;
  border-color: #4653f0;
}

.check-title-text {
  color: #1c2030;
  font-size: 26rpx;
  font-weight: 850;
  line-height: 1.4;
}

.check-desc {
  margin-top: 5rpx;
  color: #667089;
  font-size: 22rpx;
  line-height: 1.45;
}

.notice {
  margin: 12rpx 0 24rpx;
  padding: 22rpx;
  border-radius: 20rpx;
  background: #fff7ec;
  border: 1rpx solid #f6dfbd;
  color: #a25713;
  font-size: 24rpx;
  line-height: 1.6;
}

.notice-title {
  margin-bottom: 4rpx;
  font-size: 26rpx;
  font-weight: 850;
}

.primary-btn.disabled {
  background: #a8afc4;
  box-shadow: none;
}
