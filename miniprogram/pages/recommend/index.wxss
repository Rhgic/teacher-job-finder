.recommend-hero {
  padding-bottom: 28rpx;
}

.recommend-copy {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.hero-metrics {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.hero-metric {
  padding: 18rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.84);
  border: 1rpx solid rgba(20, 96, 79, 0.1);
}

.hero-metric-value {
  color: #14604f;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.hero-metric-label {
  margin-top: 8rpx;
  color: #66736d;
  font-size: 21rpx;
  font-weight: 750;
}

.run-btn {
  position: relative;
  z-index: 1;
  width: 132rpx;
  height: 58rpx;
  flex: 0 0 auto;
  margin: 0;
  padding: 0;
  font-size: 23rpx;
}

.flow-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  box-shadow: 0 12rpx 28rpx rgba(26, 52, 45, 0.06);
}

.flow-title {
  color: #15231f;
  font-size: 28rpx;
  font-weight: 850;
}

.flow-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.flow-step {
  min-width: 0;
  padding: 16rpx 12rpx;
  border-radius: 10rpx;
  background: #f6faf7;
  border: 1rpx solid #e0ebe4;
}

.flow-num {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  border-radius: 8rpx;
  background: #14604f;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
  text-align: center;
}

.flow-name {
  margin-top: 12rpx;
  color: #15231f;
  font-size: 24rpx;
  font-weight: 850;
}

.flow-desc {
  margin-top: 6rpx;
  color: #66736d;
  font-size: 20rpx;
  line-height: 1.35;
}

.list-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin: 24rpx 2rpx 16rpx;
}

.list-title {
  color: #15231f;
  font-size: 30rpx;
  font-weight: 850;
}

.match-card {
  margin-bottom: 22rpx;
  padding: 26rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  box-shadow: 0 12rpx 28rpx rgba(26, 52, 45, 0.06);
}

.match-head {
  display: flex;
  gap: 18rpx;
  align-items: stretch;
}

.score-box {
  width: 116rpx;
  flex: 0 0 116rpx;
  padding: 18rpx 10rpx;
  border-radius: 10rpx;
  background: #e7f1ee;
  text-align: center;
  box-sizing: border-box;
}

.score-value {
  color: #14604f;
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1;
}

.score-label {
  margin-top: 8rpx;
  color: #52645d;
  font-size: 20rpx;
  font-weight: 800;
}

.match-main {
  flex: 1;
  min-width: 0;
}

.match-school {
  color: #15231f;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.35;
}

.match-title {
  margin-top: 8rpx;
  color: #15231f;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 1.45;
}

.match-meta {
  margin-top: 8rpx;
  color: #66736d;
  font-size: 23rpx;
}

.reason-panel {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 10rpx;
  background: #f6faf7;
  border: 1rpx solid #e0ebe4;
}

.panel-label {
  color: #14604f;
  font-size: 22rpx;
  font-weight: 850;
}

.reason-text {
  margin-top: 8rpx;
  color: #30413a;
  font-size: 25rpx;
  line-height: 1.55;
}

.point-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.point-chip {
  max-width: 100%;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  background: #e7f1ee;
  color: #14604f;
  font-size: 22rpx;
  font-weight: 750;
  line-height: 1.35;
}

.gap-label {
  margin-top: 20rpx;
}

.gap-box {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 10rpx;
  background: #f4f8f5;
  border: 1rpx solid #dfe9e2;
}

.gap-box.warn {
  background: #fff8ee;
  border-color: #f4ddb9;
}

.gap-box.green {
  background: #f4f8f5;
  border-color: #dfe9e2;
}

.gap-text {
  color: #52645d;
  font-size: 23rpx;
  line-height: 1.5;
}

.cover-box {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #edf1ee;
}

.cover-text {
  margin-top: 8rpx;
  color: #52645d;
  font-size: 23rpx;
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.small-btn {
  flex: 1;
  height: 62rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
  font-size: 24rpx;
}

.empty-card {
  padding: 54rpx 26rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  text-align: center;
}

.empty-title {
  color: #15231f;
  font-size: 30rpx;
  font-weight: 850;
}

.empty-btn {
  width: 220rpx;
  height: 62rpx;
  margin: 24rpx auto 0;
  font-size: 24rpx;
}
