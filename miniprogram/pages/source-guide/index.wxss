.guide-hero {
  background: linear-gradient(132deg, #ffffff 0%, #eef7f2 54%, #f4efe5 100%);
}

.level-card,
.rule-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  box-shadow: 0 12rpx 28rpx rgba(26, 52, 45, 0.06);
}

.level-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.level-title {
  color: #15231f;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.3;
}

.level-desc {
  margin-top: 8rpx;
  color: #66736d;
  font-size: 23rpx;
  line-height: 1.5;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid #edf1ee;
}

.tip-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #14604f;
  flex: 0 0 10rpx;
}

.tip-text {
  flex: 1;
  min-width: 0;
  color: #30413a;
  font-size: 24rpx;
  line-height: 1.5;
}

.compact {
  margin: 0 0 14rpx;
}

.rule-row {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #edf1ee;
}

.rule-row:first-of-type {
  border-top: 0;
}

.rule-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 8rpx;
  background: #e7f1ee;
  color: #14604f;
  font-size: 22rpx;
  font-weight: 900;
  flex: 0 0 38rpx;
}

.rule-text {
  flex: 1;
  min-width: 0;
  color: #30413a;
  font-size: 24rpx;
  line-height: 1.55;
}
