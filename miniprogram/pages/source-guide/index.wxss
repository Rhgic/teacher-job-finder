.guide-hero {
}

.level-card,
.rule-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.level-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 14rpx;
}

.level-title {
  color: #1c2030;
  font-size: 29rpx;
  font-weight: 850;
  line-height: 1.3;
}

.level-desc {
  margin-top: 8rpx;
  color: #667089;
  font-size: 23rpx;
  line-height: 1.5;
}

.tip-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 10rpx 0;
  border-top: 1rpx solid #eceef7;
}

.tip-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 13rpx;
  border-radius: 50%;
  background: #4653f0;
  flex: 0 0 10rpx;
}

.tip-text {
  flex: 1;
  min-width: 0;
  color: #3a4056;
  font-size: 24rpx;
  line-height: 1.5;
}

.compact {
  margin: 0 0 14rpx;
}

.rule-row {
  display: flex;
  gap: 14rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #eceef7;
}

.rule-row:first-of-type {
  border-top: 0;
}

.rule-num {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border-radius: 14rpx;
  background: #eaedfb;
  color: #4653f0;
  font-size: 22rpx;
  font-weight: 900;
  flex: 0 0 38rpx;
}

.rule-text {
  flex: 1;
  min-width: 0;
  color: #3a4056;
  font-size: 24rpx;
  line-height: 1.55;
}
