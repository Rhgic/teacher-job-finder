<view class="page">
  <view class="hero-card guide-hero">
    <view class="hero-kicker">来源核验</view>
    <view class="hero-title">先确认，再投递</view>
    <view class="hero-subtitle">教师招聘信息会被转载，投递前要确认公告、邮箱和截止日期来自可信渠道。</view>
  </view>

  <view wx:for="{{levels}}" wx:key="title" class="level-card">
    <view class="level-head">
      <view>
        <view class="level-title">{{item.title}}</view>
        <view class="level-desc">{{item.desc}}</view>
      </view>
      <view class="pill {{index === 0 ? 'green' : index === 1 ? 'warn' : 'gray'}}">{{item.tag}}</view>
    </view>
    <view class="tip-row" wx:for="{{item.tips}}" wx:for-item="tip" wx:key="*this">
      <view class="tip-dot"></view>
      <view class="tip-text">{{tip}}</view>
    </view>
  </view>

  <view class="rule-card">
    <view class="section-title compact">投递边界</view>
    <view class="rule-row" wx:for="{{rules}}" wx:key="*this">
      <view class="rule-num">{{index + 1}}</view>
      <view class="rule-text">{{item}}</view>
    </view>
  </view>
</view>
