.notify-hero {
  padding-right: 120rpx;
}

.source-badge {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  z-index: 1;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 850;
}

.settings-card {
  margin-bottom: 22rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e5e7f4;
  box-shadow: 0 12rpx 28rpx rgba(70, 83, 240, 0.06);
}

.compact {
  margin: 0 0 14rpx;
}

.switch-row,
.pick-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 92rpx;
  border-top: 1rpx solid #eceef7;
}

.switch-row:first-of-type,
.pick-row:first-of-type {
  border-top: 0;
}

.switch-row > view,
.pick-row > view:first-child {
  flex: 1;
  min-width: 0;
}

.switch-title {
  color: #1c2030;
  font-size: 27rpx;
  font-weight: 850;
  line-height: 1.35;
}

.switch-desc {
  margin-top: 6rpx;
  color: #667089;
  font-size: 22rpx;
  line-height: 1.45;
}

.pick-value {
  flex: 0 0 auto;
  min-width: 84rpx;
  padding: 9rpx 12rpx;
  border-radius: 14rpx;
  background: #eaedfb;
  color: #4653f0;
  font-size: 23rpx;
  font-weight: 850;
  text-align: center;
}

.time-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.time-field {
  min-width: 0;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #f6f7fd;
  border: 1rpx solid #e4e7f3;
}

.time-field input {
  height: 54rpx;
  margin-top: 6rpx;
  color: #1c2030;
  font-size: 28rpx;
  font-weight: 850;
}

.auth-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 94rpx;
}

.auth-row > view {
  flex: 1;
  min-width: 0;
}

.auth-button {
  flex: 0 0 154rpx;
  min-width: 154rpx;
  height: 62rpx;
  margin: 0;
  padding: 0 14rpx;
  border-radius: 14rpx;
  background: #4653f0;
  color: #ffffff;
  font-size: 23rpx;
  font-weight: 850;
  line-height: 62rpx;
}

.auth-button::after {
  border: 0;
}

.notice-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff8ee;
  border: 1rpx solid #f4ddb9;
}

.notice-title {
  color: #a25713;
  font-size: 27rpx;
  font-weight: 850;
}

.notice-text {
  margin-top: 8rpx;
  color: #87591f;
  font-size: 24rpx;
  line-height: 1.6;
}
