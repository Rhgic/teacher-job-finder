<view class="page">
  <view class="hero-card notify-hero">
    <view class="hero-kicker">提醒设置</view>
    <view class="hero-title">别漏掉关键节点</view>
    <view class="hero-subtitle">这里先保存提醒偏好；正式接微信订阅消息后，会按这些偏好触发。</view>
    <view class="source-badge">{{sourceText}}</view>
  </view>

  <view class="settings-card">
    <view class="section-title compact">提醒类型</view>
    <view class="switch-row" data-key="deadline" bindtap="toggle">
      <view>
        <view class="switch-title">岗位截止</view>
        <view class="switch-desc">快到报名截止日时提醒核对材料</view>
      </view>
      <switch checked="{{prefs.deadline}}" color="#4653f0" />
    </view>
    <view class="switch-row" data-key="application" bindtap="toggle">
      <view>
        <view class="switch-title">投递跟进</view>
        <view class="switch-desc">待处理、失败、面试状态需要继续处理</view>
      </view>
      <switch checked="{{prefs.application}}" color="#4653f0" />
    </view>
    <view class="switch-row" data-key="materials" bindtap="toggle">
      <view>
        <view class="switch-title">材料缺口</view>
        <view class="switch-desc">证书、附件、报名表未勾选完时提醒</view>
      </view>
      <switch checked="{{prefs.materials}}" color="#4653f0" />
    </view>
    <view class="switch-row" data-key="daily" bindtap="toggle">
      <view>
        <view class="switch-title">每日汇总</view>
        <view class="switch-desc">把当天新增岗位和待办合成一条摘要</view>
      </view>
      <switch checked="{{prefs.daily}}" color="#4653f0" />
    </view>
  </view>

  <view class="settings-card">
    <view class="section-title compact">提醒节奏</view>
    <picker range="{{dayOptions}}" value="{{dayIndex}}" bindchange="onDayChange">
      <view class="pick-row">
        <view>
          <view class="switch-title">提前提醒</view>
          <view class="switch-desc">岗位截止前 {{prefs.days_before}} 天进入提醒中心</view>
        </view>
        <view class="pick-value">{{prefs.days_before}} 天</view>
      </view>
    </picker>
    <view class="time-row">
      <view class="time-field">
        <view class="switch-desc">免打扰开始</view>
        <input value="{{prefs.quiet_start}}" data-key="quiet_start" bindinput="onTimeInput" bindblur="saveTimes" />
      </view>
      <view class="time-field">
        <view class="switch-desc">免打扰结束</view>
        <input value="{{prefs.quiet_end}}" data-key="quiet_end" bindinput="onTimeInput" bindblur="saveTimes" />
      </view>
    </view>
  </view>

  <view class="settings-card">
    <view class="section-title compact">微信提醒授权</view>
    <view class="auth-row">
      <view>
        <view class="switch-title">接收订阅消息</view>
        <view class="switch-desc">微信会弹出一次性授权，后续提醒仍按上面的开关执行。</view>
      </view>
      <button class="auth-button" bindtap="requestSubscribe">{{authText}}</button>
    </view>
  </view>

  <view class="notice-card">
    <view class="notice-title">说明</view>
    <view class="notice-text">当前已保存提醒偏好；微信消息推送还需要在后台申请订阅消息模板，并由你主动授权。</view>
  </view>
</view>
