page {
  background: #f5f7f3;
  color: #15231f;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx 26rpx 54rpx;
  box-sizing: border-box;
}

.section-title {
  margin: 32rpx 0 16rpx;
  font-size: 31rpx;
  font-weight: 800;
  letter-spacing: 0;
}

.card {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
  box-shadow: 0 12rpx 28rpx rgba(26, 52, 45, 0.06);
}

.muted {
  color: #66736d;
  font-size: 24rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #e7f4ef;
  color: #126350;
  font-size: 22rpx;
  white-space: nowrap;
  font-weight: 700;
}

.pill.green {
  background: #e4f3e9;
  color: #176238;
}

.pill.gray {
  background: #edf1ef;
  color: #61706a;
}

.pill.warn {
  background: #fff2df;
  color: #a25713;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  line-height: 1;
  padding: 0;
  border-radius: 10rpx;
  background: #14604f;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 22rpx rgba(20, 96, 79, 0.2);
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  line-height: 1;
  padding: 0;
  border-radius: 10rpx;
  background: #e7f1ee;
  color: #14604f;
  font-size: 26rpx;
  font-weight: 700;
}

button::after {
  border: 0;
}

.empty {
  padding: 110rpx 24rpx;
  text-align: center;
  color: #6b7c83;
  font-size: 26rpx;
}

.hero-card {
  position: relative;
  margin-bottom: 24rpx;
  padding: 34rpx 28rpx 30rpx;
  border-radius: 14rpx;
  background: linear-gradient(132deg, #ffffff 0%, #eef7f2 52%, #e4f2f5 100%);
  border: 1rpx solid #d9e5df;
  box-shadow: 0 16rpx 38rpx rgba(26, 74, 63, 0.085);
  overflow: hidden;
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -52rpx;
  bottom: -58rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 28rpx solid rgba(56, 139, 151, 0.12);
}

.hero-kicker {
  color: #14604f;
  font-size: 21rpx;
  font-weight: 800;
}

.hero-title {
  margin-top: 8rpx;
  color: #15231f;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: #5e6d67;
  font-size: 24rpx;
  line-height: 1.5;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
  margin-top: 20rpx;
}

.metric-box {
  min-width: 0;
  padding: 18rpx 14rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6df;
}

.metric-label {
  color: #6f7c76;
  font-size: 20rpx;
}

.metric-value {
  margin-top: 6rpx;
  color: #15231f;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
}
