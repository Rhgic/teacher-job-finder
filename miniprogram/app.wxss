page {
  --brand: #4653f0;
  --brand-deep: #3a44c9;
  --brand-grad: linear-gradient(135deg, #4653f0 0%, #7b5bf5 100%);
  --ink: #1c2030;
  --ink-2: #667089;
  --ink-3: #9aa2b8;
  --bg: #f4f5fb;
  --surface: #ffffff;
  --line: #e5e7f4;
  --tint: #eef0ff;
  --ok: #0e8a5f;
  --ok-bg: #e1f6ec;
  --warn: #b4590b;
  --warn-bg: #fff1de;

  background: var(--bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 26rpx;
}

.page {
  min-height: 100vh;
  padding: 28rpx 26rpx 54rpx;
  box-sizing: border-box;
}

.section-title {
  margin: 36rpx 4rpx 18rpx;
  font-size: 32rpx;
  font-weight: 800;
  letter-spacing: 0;
  color: var(--ink);
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 12rpx;
  height: 26rpx;
  margin-right: 14rpx;
  border-radius: 6rpx;
  background: var(--brand-grad);
  vertical-align: -3rpx;
}

.card {
  margin-bottom: 24rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: var(--surface);
  border: none;
  box-shadow: 0 10rpx 30rpx rgba(70, 83, 240, 0.06);
}

.muted {
  color: var(--ink-2);
  font-size: 24rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: var(--tint);
  color: var(--brand-deep);
  font-size: 22rpx;
  white-space: nowrap;
  font-weight: 700;
}

.pill.green {
  background: var(--ok-bg);
  color: var(--ok);
}

.pill.gray {
  background: #eceef7;
  color: #646e85;
}

.pill.warn {
  background: var(--warn-bg);
  color: var(--warn);
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  line-height: 1;
  padding: 0;
  border-radius: 999rpx;
  background: var(--brand-grad);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(70, 83, 240, 0.32);
}

.ghost-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  line-height: 1;
  padding: 0;
  border-radius: 999rpx;
  background: var(--tint);
  color: var(--brand-deep);
  font-size: 26rpx;
  font-weight: 700;
}

button::after {
  border: 0;
}

.empty {
  padding: 110rpx 24rpx;
  text-align: center;
  color: var(--ink-3);
  font-size: 26rpx;
}

.hero-card {
  position: relative;
  margin-bottom: 26rpx;
  padding: 38rpx 32rpx 34rpx;
  border-radius: 28rpx;
  background: var(--brand-grad);
  border: none;
  box-shadow: 0 18rpx 44rpx rgba(70, 83, 240, 0.35);
  overflow: hidden;
  color: #ffffff;
}

.hero-card::before {
  content: "";
  position: absolute;
  left: -70rpx;
  top: -90rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.hero-card::after {
  content: "";
  position: absolute;
  right: -52rpx;
  bottom: -58rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 28rpx solid rgba(255, 255, 255, 0.12);
}

.hero-kicker {
  color: rgba(255, 255, 255, 0.78);
  font-size: 21rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.hero-title {
  margin-top: 8rpx;
  color: #ffffff;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 24rpx;
  line-height: 1.55;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.metric-box {
  min-width: 0;
  padding: 18rpx 16rpx;
  border-radius: 18rpx;
  background: var(--surface);
  box-shadow: 0 8rpx 22rpx rgba(70, 83, 240, 0.06);
}

.metric-label {
  color: var(--ink-3);
  font-size: 20rpx;
}

.metric-value {
  margin-top: 6rpx;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 800;
  line-height: 1.2;
}
