DATABASE_URL=sqlite:///./teacher_jobs.db

# DeepSeek real LLM matching.
# Get an API key from the DeepSeek platform, then copy this file to .env
# and replace the placeholder below. Keep .env private.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_STUB_MODE=1

# RAG embedding。默认 stub 可离线演示；如接智谱 embedding，再把 EMBEDDING_STUB_MODE 改为 0 并填 Key。
EMBEDDING_STUB_MODE=1
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIM=256

# QQ 邮箱 SMTP。复制为 .env 后填写真实值；SMTP_AUTH_CODE 是 QQ 邮箱授权码，不是 QQ 密码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-qq-email@qq.com
SMTP_AUTH_CODE=your-qq-mail-auth-code
EMAIL_STUB_MODE=1
