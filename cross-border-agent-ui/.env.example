# 复制为 .env 后使用。请勿把真实密钥提交到版本库。
DATABASE_URL=postgresql+psycopg://cbagent:cbagent@localhost:5433/cbagent

# JWT 签名密钥：**必填，且至少 32 字节**，否则服务拒绝启动。
# 生成：openssl rand -hex 32
# 不提供默认值是刻意的——弱默认最容易被原样带上线。
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# 演示种子账号密码（仅本地演示用；seed 会用它创建 admin/agent 两个账号）
SEED_PASSWORD=demo1234

# 可选：填了才走 DeepSeek，否则使用本地确定性草稿生成器。
# 留空时 Demo 完全可用，不需要任何外部 Key。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=20

APP_ENV=dev
LOG_LEVEL=INFO
